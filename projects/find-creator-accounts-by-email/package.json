{
  "name": "modash-find-creator-accounts-by-email",
  "version": "1.0.0",
  "private": true,
  "description": "Find creator accounts from an email list: check a CSV of emails against the Modash Discovery API and get the Instagram, TikTok and YouTube accounts that list each one, with a cost estimate, a sample run and a check on shared addresses.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run lookup-example",
    "lookup-example": "tsx src/cli.ts lookup-example",
    "estimate": "tsx src/cli.ts estimate",
    "lookup": "tsx src/cli.ts lookup",
    "typecheck": "tsgo --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "lodash-es": "^4.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.19.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "tsx": "^4.20.6"
  }
}
