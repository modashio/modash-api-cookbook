# Copy to .env and uncomment what you need. .env is gitignored; never commit a real token.
#
# Copied as-is, this file leaves you in mock mode: invented creators, no network, no credits.

# Your Modash API token, from https://marketer.modash.io/developer
# MODASH_API_TOKEN=your-token-here

# Answer from the invented fixtures instead of calling the API. Defaults to true whenever
# MODASH_API_TOKEN is unset. Set it to true to stay on fixtures even with a token present.
# MODASH_MOCK=true

# Hard ceiling on Discovery credits one run may spend. The run stops before any call that could
# take it over. A creator typically costs 1 to 3 credits. --max-credits overrides it for one run.
MODASH_CREDIT_BUDGET=50
