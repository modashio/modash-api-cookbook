    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsgo --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "tsx": "^4.20.6"
  }
}
