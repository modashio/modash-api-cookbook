{
  "name": "modash-cross-platform-influencer-search",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform influencer search via API: find one creator's Instagram, TikTok and YouTube accounts with the Modash Discovery API, with the evidence for each link.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts --mock",
    "match": "tsx src/cli.ts",
