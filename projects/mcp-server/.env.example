# Copy to .env and uncomment what you need. .env is gitignored; never commit a real token.
#
# Copied as-is, this file leaves you in mock mode: synthetic fixtures, no network, no credits.
# That is deliberate — a straight copy should never start spending money or failing on a
# placeholder token. Uncomment MODASH_API_TOKEN when you want to talk to the real API.

# Your Modash API token, from https://marketer.modash.io/developer
# MODASH_API_TOKEN=your-token-here

# Serve synthetic fixtures instead of calling the API. Defaults to true whenever
# MODASH_API_TOKEN is unset, so the server always starts. Set it explicitly to stay on fixtures
# even with a token present, or to false to insist on live mode.
# MODASH_MOCK=true

# Hard ceiling on Discovery credits this process may spend before it starts refusing paid tool
# calls. Counts estimated cost, so it stops you *before* the spend, not after.
MODASH_CREDIT_BUDGET=5

# The RAW API is a separate Modash product from Discovery, giving live unfiltered platform data.
# Its six tools stay out of the tool list unless you turn them on, because an account without
# the product answers every one of them with feature_not_available.
# MODASH_RAW=true

# Hard ceiling on RAW requests per session. RAW is metered in requests, from a different allowance
# to credits, and it bills failed requests too — so this counts attempts, not successes.
MODASH_RAW_BUDGET=50

# Port for the Streamable HTTP transport (npm run dev). Ignored by the stdio transport.
PORT=3000

# Interface the HTTP transport binds to. Loopback by default: the endpoint has no authentication
# and holds your token, so anyone who can reach it can spend your credits. Set it to 0.0.0.0 only
# when the server runs somewhere the client cannot reach over loopback — in a container, say — and
# something else is controlling who gets to the port.
# MODASH_HTTP_HOST=127.0.0.1

# Optional. Base URL of the Modash API; only change this if you have been told to.
# MODASH_API_BASE_URL=https://api.modash.io/v1
