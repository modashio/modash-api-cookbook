# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Modash API
# ---------------------------------------------------------------------------

# Your Modash API token: https://marketer.modash.io/developer
# Requires Discovery API access. Leave empty to run in mock mode.
MODASH_API_TOKEN=

# Serve synthetic data instead of calling the Modash API.
# Defaults to true when MODASH_API_TOKEN is empty, so the demo always runs.
MODASH_MOCK=

# Hard cap on estimated credits a single chat session may spend.
# AI Search costs 0.025 credits per returned profile, so 5 credits is ~200 profiles.
MODASH_CREDIT_BUDGET=5

# Max profiles the agent may request in one search (each one costs credits).
MODASH_MAX_PAGE_SIZE=20

# ---------------------------------------------------------------------------
# Model provider — you only need one of these
# ---------------------------------------------------------------------------

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional override, e.g. `gpt-5.1` or `claude-sonnet-4-5`.
# Defaults to a sensible model for whichever provider key is present.
AGENT_MODEL=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=3000

# Hosts allowed to reach the Vite dev server. Only needed when you open the app
# through a proxy or tunnel rather than localhost — an IDE's built-in browser,
# ngrok, a codespace forwarder. Comma-separated, or `all` in a throwaway sandbox.
VITE_ALLOWED_HOSTS=
